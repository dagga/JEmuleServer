@startuml
package "org.jemule" {
    class Main {
        +main(String[] args)
    }

    package "org.jemule.config" {
        class ServerConfig <<record>> {
            +port: int
            +maxPacketSize: int
            +maxSearchResults: int
            +floodMaxRequestsPerSecond: int
            +ipFilterPath: String
            +fakeFileDetectionEnabled: boolean
            +kad: KadConfig
            +{static} DEFAULT: ServerConfig
        }

        class KadConfig <<record>> {
            +enabled: boolean
            +port: int
            +bootstrapFromClients: boolean
            +maxRoutingContacts: int
            +forkSearchEnabled: boolean
            +searchTimeoutSeconds: int
            +autoIngestToH2: boolean
            +minSourcesForIngest: int
            +effectivePort(int): int
        }
    }

    package "org.jemule.network" {
        class Server {
            -config: ServerConfig
            -registry: ClientRegistry
            -fileIndex: FileIndex
            -floodProtector: FloodProtector
            -executor: ExecutorService
            +start()
            +stop()
            -startUdpResponder()
            -handleUdp(DatagramSocket, DatagramPacket)
        }

        class ClientHandler {
            -socket: Socket
            -config: ServerConfig
            -registry: ClientRegistry
            -fileIndex: FileIndex
            -floodProtector: FloodProtector
            -state: ClientState
            +run()
            -negotiateObfuscation()
            -handleLogin()
            -processPacket()
        }

        class AdminInterface {
            +handleCommand(String)
            -handleKad(String[])
        }

        class SearchHandler {
            +handleSearch(ClientContext, byte[], OutputStream)
            +handleQueryMoreResult(ClientContext, OutputStream)
        }

        class Packet <<record>> {
            +protocol: byte
            +opcode: byte
            +data: byte[]
            +{static} read(InputStream, int): Packet
            +write(OutputStream, boolean)
        }
    }

    package "org.jemule.core" {
        class DatabaseManager {
            -connection: Connection
            -circuitBreaker: CircuitBreaker
            +saveFile(FileMetadata)
            +loadFiles(): List<FileMetadata>
        }

        class ClientRegistry {
            -clients: Map<Integer, ClientState>
            +add(ClientState)
            +remove(ClientState)
            +size(): int
        }

        class ClientState {
            -address: InetAddress
            -port: int
            -clientId: int
            -zlibSupported: boolean
            -publishedFilesCount: AtomicInteger
            -messenger: Consumer<Packet>
            +isHighId(): boolean
        }

        class ClientFactory {
            +createClient(InetAddress, int, int): ClientState
        }

        class FileIndex {
            -byHash: Map<String, FileMetadata>
            -invertedIndex: ConcurrentSkipListMap
            -searchCache: Map
            +addFile(FileMetadata)
            +search(String, int): List<FileMetadata>
            +searchComplex(SearchQuery, int): List<FileMetadata>
            +getSources(String, ClientState, int): List<ClientState>
        }

        class FileMetadata <<record>> {
            +hash: String
            +name: String
            +size: long
            +type: String
            +tags: List<Tag>
            +sources: ConcurrentHashMap
        }

        class SearchQueryBuilder {
            +build(): SearchQuery
        }

        interface SearchQuery <<functional>> {
            +test(FileMetadata): boolean
            +{static} parse(ByteBuffer): SearchQuery
        }
    }

    package "org.jemule.kad" {
        class KadNode {
            +start()
            +onClientConnected(ClientState)
            +bootstrap(InetAddress, int): boolean
            +status(): Status
            +close()
        }
        class KadId {
            +distance(KadId): KadId
            +{static} fromKeyword(String): KadId
            +{static} random(): KadId
        }
        class KadRoutingTable {
            -buckets: KadBucket[128]
            +addOrUpdate(KadContact): boolean
            +findClosest(KadId, int): List<KadContact>
        }
        class KadBucket {
            -contacts: k = 20
            -replacementCache
        }
        class KadContact {
            +id: KadId
            +address: InetAddress
            +udpPort: int
            +failedPings: int
        }
        class KadUdpService {
            +start()
            +send(KadPacket, InetAddress, int)
            +registerListener(KadOpCode, KadPacketListener)
        }
        class KadPacket {
            +encode(): byte[]
            +{static} decode(byte[]): KadPacket
        }
        class KadBootstrapManager {
            +onClientConnected(ClientState)
            +bootstrap(InetAddress, int): boolean
            +getStatus(): Status
        }
        class KadMaintenanceService {
            -pingContact(KadContact)
            -refreshBucket(int)
        }
        class KadSearchBridge {
            +forkSearch(SearchQuery): CompletableFuture<List<FileMetadata>>
            #acceptFile(FileMetadata): boolean
            #handleSearchRes(KadPacket, InetAddress, int)
        }
        class KadHashBanService {
            +initialize()
            +onIllicitFile(FileMetadata, String)
        }
    }

    package "org.jemule.core.event" {
        class EventManager {
            -subscribers: Map
            +subscribe(String, Consumer)
            +broadcast(Event)
        }
        interface Event {
            +getType(): String
            +getMessage(): String
        }
    }

    package "org.jemule.protocol" {
        enum OpCode {
            LOGIN_REQUEST
            SERVER_STATUS
            SERVER_IDENT
            ...
            +{static} fromByte(byte, byte): OpCode
        }

        class Tag <<record>> {
            +type: byte
            +name: String
            +value: Object
            +{static} readList(ByteBuffer): List<Tag>
            +{static} writeList(ByteBuffer, List<Tag>)
        }
    }

    package "org.jemule.security" {
        class Obfuscation {
            +{static} md5(byte[]...): byte[]
        }
        class RC4 {
            +crypt(byte[])
        }
        class FloodProtector {
            +allow(InetAddress): boolean
        }
        class IPFilter {
            +isBlocked(InetAddress): boolean
        }
        class FakeFileDetector {
            +isFake(FileMetadata): boolean
        }
        class ChildAbuseFilter {
            +matches(String): boolean
        }
    }
}

Server --> ServerConfig
Server --> ClientRegistry
Server --> FileIndex
Server --> FloodProtector
Server --> EventManager
Server --> ClientFactory
Server --> DatabaseManager
Server --> IPFilter
Server ..> ClientHandler : creates
ClientHandler --> ServerConfig
ClientHandler --> ClientRegistry
ClientHandler --> FileIndex
ClientHandler --> ClientState
ClientHandler --> EventManager
ClientHandler --> ClientFactory
ClientHandler --> FakeFileDetector
ClientHandler ..> Packet : uses
ClientHandler ..> OpCode : uses
FileIndex --> FileMetadata
FileIndex --> DatabaseManager
FileIndex --> EventManager
FileMetadata --> Tag
SearchQueryBuilder ..> SearchQuery : builds
SearchQuery <|.. TermQuery
SearchQuery <|.. AndQuery
SearchQuery <|.. OrQuery
SearchQuery <|.. NotQuery
ServerConfig --> KadConfig
Server --> KadNode
Server --> AdminInterface
AdminInterface --> KadNode
SearchHandler --> FileIndex
SearchHandler ..> KadSearchBridge : forks searches
KadNode --> KadConfig
KadNode --> KadRoutingTable
KadNode --> KadUdpService
KadNode --> KadBootstrapManager
KadNode --> KadMaintenanceService
KadNode --> KadSearchBridge
KadNode --> KadHashBanService
KadRoutingTable --> KadBucket
KadBucket --> KadContact
KadContact --> KadId
KadBootstrapManager --> KadRoutingTable
KadBootstrapManager --> KadUdpService
KadMaintenanceService --> KadRoutingTable
KadMaintenanceService --> KadUdpService
KadSearchBridge --> KadRoutingTable
KadSearchBridge --> KadUdpService
KadSearchBridge --> ChildAbuseFilter
KadSearchBridge --> FakeFileDetector
KadSearchBridge --> FileIndex : ingests
KadHashBanService --> DatabaseManager
KadHashBanService --> FakeFileDetector
KadUdpService ..> KadPacket : uses
@enduml
